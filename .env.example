# Google Cloud / Agent Builder
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash-lite

# Gemini auth — pick ONE mode:
#
# Option A: Vertex AI (uses GCP $300 trial credits)
GOOGLE_GENAI_USE_VERTEXAI=true
# Then run: gcloud auth application-default login
# Optional: silence ADC quota-project warning (defaults to GCP_PROJECT_ID)
# GOOGLE_CLOUD_QUOTA_PROJECT=
#
# Option B: AI Studio (separate free tier; does NOT use GCP credits)
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=

# MongoDB (MCP + direct client for pipelines)
MONGO_URI=
MONGODB_URI=
CONNECTION_STRING=
MONGO_DB_NAME=quant
MONGODB_DB=quant

# FRED API (macro ingestion)
FRED_API_KEY=

# Elastic (MCP + direct client for pipelines)
ELASTIC_URL=
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_INDEX=market_state_v1

# SEC EDGAR (required User-Agent per SEC policy)
SEC_USER_AGENT=QuantHackathon your-email@example.com

# API / Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000
# GOOGLE_CLOUD_QUOTA_PROJECT=

# Demo
DEMO_TICKER=AAPL
DEMO_INJECT_MODEL_ERROR=false
DEMO_USE_CACHED_FILING=false

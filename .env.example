# Google Cloud / Agent Builder
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# MongoDB (MCP + direct client for pipelines)
MONGO_URI=
MONGODB_URI=
MONGO_DB_NAME=quant
MONGODB_DB=quant

# FRED API (macro ingestion)
FRED_API_KEY=

# Elastic (MCP + direct client for pipelines)
ELASTIC_URL=
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_INDEX=market_state_v1

# SEC EDGAR (required User-Agent per SEC policy)
SEC_USER_AGENT=QuantHackathon your-email@example.com

# Demo
DEMO_TICKER=AAPL
DEMO_INJECT_MODEL_ERROR=false
DEMO_USE_CACHED_FILING=false
